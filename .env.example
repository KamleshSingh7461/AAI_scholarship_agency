# =============================================================================
# Alumni Connect India — LOCAL environment
# `npm run setup` copies this to .env and fills in random secrets + JWT keys.
# Production uses env/production.env.example instead (never commit real values).
# =============================================================================

NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug

# ---- Public URLs -------------------------------------------------------------
PUBLIC_WEB_URL=http://localhost:3000
STUDENT_WEB_URL=http://localhost:3001
ADMIN_WEB_URL=http://localhost:3002
API_PUBLIC_URL=http://localhost:8080

# ---- Shared infrastructure (docker-compose.infra.yml) ------------------------
POSTGRES_HOST_PORT=55432
POSTGRES_SUPERUSER=aci_admin
POSTGRES_SUPERUSER_PASSWORD=aci_admin_local_pw
SERVICE_DB_PASSWORD=aci_local_pw
RABBITMQ_USER=aci
RABBITMQ_PASSWORD=aci_local_pw
RABBITMQ_URL=amqp://aci:aci_local_pw@localhost:5672
REDIS_URL=redis://localhost:6379

# One database per service (database-per-service pattern)
AUTH_DATABASE_URL=postgresql://aci_auth:aci_local_pw@localhost:55432/aci_auth?schema=public
ATHLETE_DATABASE_URL=postgresql://aci_athlete:aci_local_pw@localhost:55432/aci_athlete?schema=public
UNIVERSITY_DATABASE_URL=postgresql://aci_university:aci_local_pw@localhost:55432/aci_university?schema=public
APPLICATION_DATABASE_URL=postgresql://aci_application:aci_local_pw@localhost:55432/aci_application?schema=public
PAYMENT_DATABASE_URL=postgresql://aci_payment:aci_local_pw@localhost:55432/aci_payment?schema=public
ESIGN_DATABASE_URL=postgresql://aci_esign:aci_local_pw@localhost:55432/aci_esign?schema=public
DOCUMENT_DATABASE_URL=postgresql://aci_document:aci_local_pw@localhost:55432/aci_document?schema=public
NOTIFICATION_DATABASE_URL=postgresql://aci_notification:aci_local_pw@localhost:55432/aci_notification?schema=public
FINANCE_DATABASE_URL=postgresql://aci_finance:aci_local_pw@localhost:55432/aci_finance?schema=public

# ---- Service discovery (host-run services) -----------------------------------
AUTH_SERVICE_URL=http://localhost:4001
ATHLETE_SERVICE_URL=http://localhost:4002
UNIVERSITY_SERVICE_URL=http://localhost:4003
APPLICATION_SERVICE_URL=http://localhost:4004
PAYMENT_SERVICE_URL=http://localhost:4005
ESIGN_SERVICE_URL=http://localhost:4006
DOCUMENT_SERVICE_URL=http://localhost:4007
NOTIFICATION_SERVICE_URL=http://localhost:4008
FINANCE_SERVICE_URL=http://localhost:4009

# ---- Security ----------------------------------------------------------------
# Shared secret for service-to-service calls (x-internal-token). >= 32 chars.
INTERNAL_API_TOKEN=__GENERATED__
JWT_ISSUER=alumni-connect-auth
JWT_AUDIENCE=alumni-connect
JWT_PUBLIC_KEY_FILE=env/keys/jwt-public.pem
AUTH_JWT_PRIVATE_KEY_FILE=env/keys/jwt-private.pem

# ---- Gateway -----------------------------------------------------------------
GATEWAY_PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30

# ---- Auth / OTP --------------------------------------------------------------
AUTH_OTP_PEPPER=__GENERATED__
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_PER_HOUR=6
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# LOCAL ONLY: returns the OTP in the API response so you can test without SMS. Refused in production.
AUTH_DEV_ECHO_OTP=true
# Created by `npm run db:seed` as the first SUPER_ADMIN (log in with OTP on this number)
SEED_SUPER_ADMIN_PHONE=+919999900001
SEED_SUPER_ADMIN_NAME=Platform Owner

# ---- Notifications (SMS / WhatsApp / Email) ----------------------------------
# console = log to terminal. Real: SMS_PROVIDER=msg91|twilio, WHATSAPP_PROVIDER=meta|twilio
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
EMAIL_PROVIDER=smtp
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_DEFAULT_FLOW_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v21.0
META_WA_OTP_TEMPLATE=aci_login_otp
META_WA_NOTIFY_TEMPLATE=aci_notification
META_WA_TEMPLATE_LANG=en
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Alumni Connect India <no-reply@alumniindia.com>"

# ---- Payments ----------------------------------------------------------------
# mock | razorpay | cashfree | payu
PAYMENT_PROVIDER=mock
PAYMENT_ORDER_EXPIRY_MINUTES=30
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=test
COMPANY_LEGAL_NAME=Alumni Connect India Private Limited
COMPANY_BRAND_NAME=Alumni Connect India
COMPANY_GSTIN=
COMPANY_ADDRESS=

# ---- E-signature -------------------------------------------------------------
# mock | docusign
ESIGN_PROVIDER=mock
ESIGN_ENVELOPE_EXPIRY_DAYS=14
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY_FILE=
DOCUSIGN_OAUTH_HOST=account-d.docusign.com
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_CONNECT_HMAC_KEY=
COMPANY_SIGNATORY_NAME=Authorised Signatory
COMPANY_SIGNATORY_EMAIL=signatory@alumniindia.com

# ---- Documents (S3; SeaweedFS locally) ------------------------------------------------
S3_ENDPOINT=http://localhost:9000
# Endpoint the BROWSER uses for presigned URLs (differs from S3_ENDPOINT inside docker)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=aci-documents
S3_ACCESS_KEY_ID=aci_minio
S3_SECRET_ACCESS_KEY=aci_minio_local_pw
S3_FORCE_PATH_STYLE=true
DOCUMENT_MAX_UPLOAD_MB=10

# ---- Scholarship lifecycle ---------------------------------------------------
AGREEMENT_SIGNING_DEADLINE_DAYS=14
RENEWAL_REMINDER_DAYS_BEFORE=30
RENEWAL_ENVELOPE_DAYS_BEFORE=0
RENEWAL_GRACE_DAYS=14
# 6-field cron (sec min hour dom mon dow), UTC. 03:30 UTC = 09:00 IST
LIFECYCLE_CRON=0 30 3 * * *
DEFAULT_AGENCY_COMMISSION_BPS=800

# ---- Finance -----------------------------------------------------------------
# FULL_AT_GRANT (management policy) | RATABLE
REVENUE_RECOGNITION_POLICY=FULL_AT_GRANT
DEFAULT_USD_INR_RATE=83.0000
