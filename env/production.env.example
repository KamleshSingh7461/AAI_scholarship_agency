# =============================================================================
# Alumni Connect India — PRODUCTION environment (template)
# Copy to env/production.env on the server (chmod 600). NEVER commit the real file.
# Prefer a secrets manager (AWS Secrets Manager / Doppler / Vault) that renders this file at deploy time.
# =============================================================================

NODE_ENV=production
APP_ENV=production
LOG_LEVEL=info

IMAGE_REGISTRY=ghcr.io/your-org
IMAGE_TAG=v1.0.0

# ---- Domains ----------------------------------------------------------------
PUBLIC_DOMAIN=alumniconnectindia.com
STUDENT_DOMAIN=app.alumniconnectindia.com
ADMIN_DOMAIN=admin.alumniconnectindia.com
API_DOMAIN=api.alumniconnectindia.com
ACME_EMAIL=tech@alumniconnectindia.com
# Space-separated CIDRs allowed to open the admin panel (office / VPN). Default allows all.
ADMIN_ALLOWED_IPS=0.0.0.0/0 ::/0

PUBLIC_WEB_URL=https://alumniconnectindia.com
STUDENT_WEB_URL=https://app.alumniconnectindia.com
ADMIN_WEB_URL=https://admin.alumniconnectindia.com
API_PUBLIC_URL=https://api.alumniconnectindia.com
CORS_ORIGINS=https://alumniconnectindia.com,https://app.alumniconnectindia.com,https://admin.alumniconnectindia.com
TRUST_PROXY=1

# ---- Managed infrastructure (TLS everywhere) --------------------------------
RABBITMQ_URL=amqps://aci:CHANGE_ME@your-mq-host:5671/aci
REDIS_URL=rediss://default:CHANGE_ME@your-redis-host:6380
AUTH_DATABASE_URL=postgresql://aci_auth:CHANGE_ME@db-host:5432/aci_auth?schema=public&sslmode=require&connection_limit=10
ATHLETE_DATABASE_URL=postgresql://aci_athlete:CHANGE_ME@db-host:5432/aci_athlete?schema=public&sslmode=require&connection_limit=10
UNIVERSITY_DATABASE_URL=postgresql://aci_university:CHANGE_ME@db-host:5432/aci_university?schema=public&sslmode=require&connection_limit=10
APPLICATION_DATABASE_URL=postgresql://aci_application:CHANGE_ME@db-host:5432/aci_application?schema=public&sslmode=require&connection_limit=10
PAYMENT_DATABASE_URL=postgresql://aci_payment:CHANGE_ME@db-host:5432/aci_payment?schema=public&sslmode=require&connection_limit=10
ESIGN_DATABASE_URL=postgresql://aci_esign:CHANGE_ME@db-host:5432/aci_esign?schema=public&sslmode=require&connection_limit=10
DOCUMENT_DATABASE_URL=postgresql://aci_document:CHANGE_ME@db-host:5432/aci_document?schema=public&sslmode=require&connection_limit=10
NOTIFICATION_DATABASE_URL=postgresql://aci_notification:CHANGE_ME@db-host:5432/aci_notification?schema=public&sslmode=require&connection_limit=10
FINANCE_DATABASE_URL=postgresql://aci_finance:CHANGE_ME@db-host:5432/aci_finance?schema=public&sslmode=require&connection_limit=10

AUTH_SERVICE_URL=http://auth-service:4001
ATHLETE_SERVICE_URL=http://athlete-service:4002
UNIVERSITY_SERVICE_URL=http://university-service:4003
APPLICATION_SERVICE_URL=http://application-service:4004
PAYMENT_SERVICE_URL=http://payment-service:4005
ESIGN_SERVICE_URL=http://esign-service:4006
DOCUMENT_SERVICE_URL=http://document-service:4007
NOTIFICATION_SERVICE_URL=http://notification-service:4008
FINANCE_SERVICE_URL=http://finance-service:4009

# ---- Security (generate: openssl rand -base64 48) ---------------------------
INTERNAL_API_TOKEN=CHANGE_ME_LONG_RANDOM
AUTH_OTP_PEPPER=CHANGE_ME_LONG_RANDOM
JWT_ISSUER=alumni-connect-auth
JWT_AUDIENCE=alumni-connect
# PEMs inline with literal \n (or mount files and use *_FILE variables)
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
AUTH_JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
AUTH_COOKIE_DOMAIN=
AUTH_DEV_ECHO_OTP=false
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=30
AUTH_OTP_MAX_PER_HOUR=6
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30

# ---- Notifications ----------------------------------------------------------
# India SMS needs a DLT-registered sender ID + templates (TRAI). WhatsApp needs Meta-approved templates.
SMS_PROVIDER=msg91
WHATSAPP_PROVIDER=meta
EMAIL_PROVIDER=smtp
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
MSG91_DEFAULT_FLOW_ID=
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_API_VERSION=v21.0
META_WA_OTP_TEMPLATE=aci_login_otp
META_WA_NOTIFY_TEMPLATE=aci_notification
META_WA_TEMPLATE_LANG=en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Alumni Connect India <no-reply@alumniconnectindia.com>"

# ---- Payments (whichever gateway is approved first) -------------------------
PAYMENT_PROVIDER=razorpay
PAYMENT_ORDER_EXPIRY_MINUTES=30
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=production
CASHFREE_API_VERSION=2023-08-01
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SALT=
PAYU_ENV=production
COMPANY_LEGAL_NAME=Alumni Connect India Private Limited
COMPANY_BRAND_NAME=Alumni Connect India
COMPANY_GSTIN=
COMPANY_ADDRESS=

# ---- DocuSign ---------------------------------------------------------------
ESIGN_PROVIDER=docusign
ESIGN_ENVELOPE_EXPIRY_DAYS=14
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
DOCUSIGN_OAUTH_HOST=account.docusign.com
DOCUSIGN_BASE_PATH=https://in.docusign.net/restapi
DOCUSIGN_CONNECT_HMAC_KEY=
COMPANY_SIGNATORY_NAME=Authorised Signatory
COMPANY_SIGNATORY_EMAIL=signatory@alumniindia.com

# ---- Documents --------------------------------------------------------------
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=aci-documents-prod
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
DOCUMENT_MAX_UPLOAD_MB=10

# ---- Lifecycle / finance ----------------------------------------------------
AGREEMENT_SIGNING_DEADLINE_DAYS=14
RENEWAL_REMINDER_DAYS_BEFORE=30
RENEWAL_ENVELOPE_DAYS_BEFORE=0
RENEWAL_GRACE_DAYS=14
LIFECYCLE_CRON=0 30 3 * * *
DEFAULT_AGENCY_COMMISSION_BPS=800
REVENUE_RECOGNITION_POLICY=FULL_AT_GRANT
DEFAULT_USD_INR_RATE=83.0000
