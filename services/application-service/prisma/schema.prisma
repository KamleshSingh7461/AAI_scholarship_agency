// application-service: scholarship applications, awards (the scholarship "inventory" ledger per athlete) and yearly renewals

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("APPLICATION_DATABASE_URL")
}

model Application {
  id                           String                     @id @default(uuid()) @db.Uuid
  applicationNo                String                     @unique
  athleteUserId                String                     @db.Uuid
  athleteProfileId             String                     @db.Uuid
  athleteCode                  String
  athleteName                  String
  athletePhone                 String
  whatsappNumber               String
  athleteEmail                 String?
  sport                        String?
  isMinor                      Boolean                    @default(false)
  guardian                     Json?

  programId                    String                     @db.Uuid
  programName                  String
  universityId                 String                     @db.Uuid
  universityName               String
  academicYear                 String
  durationYears                Int
  currency                     String
  annualValue                  BigInt
  totalValue                   BigInt
  /// USD→INR ×10000 at application time (display only; the award re-snapshots at grant)
  usdInrRate4                  Int                        @default(830000)
  /// Full program terms at application time (values, fee, bearers) — immutable evidence
  programSnapshot              Json

  statement                    String?
  preferredCourse              String?

  status                       String                     @default("DRAFT")
  feeBaseInr                   BigInt                     @default(0)
  feeTaxInr                    BigInt                     @default(0)
  feeTotalInr                  BigInt                     @default(0)
  feeExplanation               String?
  feeWaived                    Boolean                    @default(false)
  /// NOT_REQUIRED | PENDING | PAID | REFUND_REQUESTED | REFUNDED
  paymentStatus                String                     @default("NOT_REQUIRED")
  paymentOrderId               String?                    @db.Uuid
  paidAt                       DateTime?

  submittedAt                  DateTime?
  reviewerId                   String?                    @db.Uuid
  forwardedAt                  DateTime?
  universityDecisionAt         DateTime?
  universityDecisionById       String?                    @db.Uuid
  universityDecisionNote       String?
  universityApprovalDocumentId String?                    @db.Uuid
  rejectionReason              String?
  createdByStaffId             String?                    @db.Uuid

  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @updatedAt
  history                      ApplicationStatusHistory[]
  notes                        ApplicationNote[]
  award                        Award?

  @@index([athleteUserId, status])
  @@index([programId, status])
  @@index([universityId, status])
  @@index([status, updatedAt])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String?
  toStatus      String
  actorId       String?     @db.Uuid
  actorRole     String?
  note          String?
  createdAt     DateTime    @default(now())

  @@index([applicationId, createdAt])
  @@index([createdAt])
  @@map("application_status_history")
}

/// Internal staff notes, never shown to the athlete.
model ApplicationNote {
  id            String      @id @default(uuid()) @db.Uuid
  applicationId String      @db.Uuid
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String      @db.Uuid
  authorName    String?
  body          String
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("application_notes")
}

/// One awarded scholarship. This is the auditable record management asked for:
/// who it went to, WhatsApp #, student id, date passed out, sport, school, 2/3/4-year,
/// quantified tuition/room/food, and the signed agency agreement.
model Award {
  id                               String      @id @default(uuid()) @db.Uuid
  awardNo                          String      @unique
  applicationId                    String      @unique @db.Uuid
  application                      Application @relation(fields: [applicationId], references: [id])
  athleteUserId                    String      @db.Uuid
  athleteCode                      String
  athleteName                      String
  whatsappNumber                   String
  athleteEmail                     String?
  sport                            String?
  isMinor                          Boolean     @default(false)
  guardian                         Json?

  universityId                     String      @db.Uuid
  universityName                   String
  programId                        String      @db.Uuid
  programName                      String
  academicYear                     String

  durationYears                    Int
  currency                         String
  tuitionPerYear                   BigInt
  roomPerYear                      BigInt
  foodPerYear                      BigInt
  otherPerYear                     BigInt
  annualValue                      BigInt
  totalValue                       BigInt
  universityFundedAnnual           BigInt      @default(0)
  companyFundedAnnual              BigInt      @default(0)
  /// 1 USD = usdInrRate4 / 10000 INR, snapshotted when offered and re-snapshotted at grant
  usdInrRate4                      Int
  commissionBps                    Int
  universityCommissionShareBps     Int

  /// PENDING_SIGNATURE | ACTIVE | RENEWAL_DUE | SUSPENDED | COMPLETED | EXPIRED | REVOKED
  status                           String      @default("PENDING_SIGNATURE")
  currentYear                      Int         @default(0)
  offeredAt                        DateTime    @default(now())
  agreementsDeadline               DateTime
  /// "Date passed out": when both agreements were signed. Revenue is booked on this date.
  grantDate                        DateTime?
  startDate                        DateTime?   @db.Date
  endDate                          DateTime?   @db.Date

  scholarshipEnvelopeId            String?     @db.Uuid
  scholarshipSignedAt              DateTime?
  scholarshipSignedDocumentId      String?     @db.Uuid
  agencyEnvelopeId                 String?     @db.Uuid
  agencySignedAt                   DateTime?
  agencySignedDocumentId           String?     @db.Uuid
  lastReminderAt                   DateTime?

  /// University's own confirmation of the booked value (audit trail for the auditors)
  universityConfirmationStatus     String      @default("PENDING")
  universityConfirmedAt            DateTime?
  universityConfirmedById          String?     @db.Uuid
  universityConfirmationDocumentId String?     @db.Uuid
  universityConfirmationNote       String?

  suspendedAt                      DateTime?
  suspensionReason                 String?
  revokedAt                        DateTime?
  revokeReason                     String?
  completedAt                      DateTime?
  createdAt                        DateTime    @default(now())
  updatedAt                        DateTime    @updatedAt
  years                            AwardYear[]

  @@index([athleteUserId])
  @@index([universityId, status])
  @@index([status])
  @@index([grantDate])
  @@map("awards")
}

/// One row per scholarship year. Year 1 is renewed by the initial signing; every later
/// year requires the athlete to register (confirm enrolment + policy) and re-sign both agreements.
model AwardYear {
  id                       String    @id @default(uuid()) @db.Uuid
  awardId                  String    @db.Uuid
  award                    Award     @relation(fields: [awardId], references: [id], onDelete: Cascade)
  yearNumber               Int
  academicYear             String
  periodStart              DateTime  @db.Date
  periodEnd                DateTime  @db.Date
  /// The anniversary on which this year must be renewed
  dueDate                  DateTime  @db.Date
  /// UPCOMING | DUE | OVERDUE | RENEWED | SUSPENDED | CANCELLED
  status                   String    @default("UPCOMING")
  tuitionAmount            BigInt
  roomAmount               BigInt
  foodAmount               BigInt
  otherAmount              BigInt
  amount                   BigInt

  // Annual registration
  enrollmentConfirmed      Boolean   @default(false)
  currentCourse            String?
  currentSemester          String?
  academicScore            String?
  policyAcknowledged       Boolean   @default(false)
  registrationDocumentId   String?   @db.Uuid
  registrationSubmittedAt  DateTime?

  // Annual signatures
  scholarshipEnvelopeId    String?   @db.Uuid
  scholarshipSignedAt      DateTime?
  agencyEnvelopeId         String?   @db.Uuid
  agencySignedAt           DateTime?

  reminderSentAt           DateTime?
  openedAt                 DateTime?
  overdueAt                DateTime?
  renewedAt                DateTime?
  suspendedAt              DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@unique([awardId, yearNumber])
  @@index([status, dueDate])
  @@map("award_years")
}

// ---------------------------------------------------------------------------
// Common tables required by @aci/nest-common (outbox, inbox, audit).
// ---------------------------------------------------------------------------

model OutboxEvent {
  id          String    @id @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, handler])
  @@map("processed_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
