// notification-service: outbound SMS / WhatsApp / email, templates and delivery log

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("NOTIFICATION_DATABASE_URL")
}

/// Editable message templates. {{var}} placeholders are filled from event data.
/// WhatsApp business-initiated messages must use a Meta-approved template (providerTemplate);
/// Indian SMS must use a DLT-registered template (dltTemplateId).
model NotificationTemplate {
  id               String   @id @default(uuid()) @db.Uuid
  key              String
  /// SMS | WHATSAPP | EMAIL
  channel          String
  subject          String?
  body             String
  providerTemplate String?
  dltTemplateId    String?
  active           Boolean  @default(true)
  updatedById      String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([key, channel])
  @@map("notification_templates")
}

model NotificationLog {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String?   @db.Uuid
  templateKey       String
  channel           String
  recipient         String
  subject           String?
  body              String
  /// QUEUED | SENT | FAILED | SKIPPED
  status            String    @default("QUEUED")
  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  /// Provider-specific extras (WhatsApp template params, DLT variables)
  meta              Json?
  sourceEventId     String?   @db.Uuid
  sentAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
  @@index([templateKey])
  @@map("notification_logs")
}

// ---------------------------------------------------------------------------
// Common tables required by @aci/nest-common (outbox, inbox, audit).
// ---------------------------------------------------------------------------

model OutboxEvent {
  id          String    @id @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  handler     String
  processedAt DateTime @default(now()) @map("processed_at")

  @@id([eventId, handler])
  @@map("processed_events")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id")
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
