# api-gateway — production variables
NODE_ENV=production
APP_ENV=production
GATEWAY_PORT=8080
REDIS_URL=rediss://:CHANGE_ME@redis-host:6380
CORS_ORIGINS=https://alumniconnectindia.com,https://app.alumniconnectindia.com,https://admin.alumniconnectindia.com
# Hops in front of the gateway you trust for X-Forwarded-For (load balancer / ingress)
TRUST_PROXY=1
RATE_LIMIT_PER_MINUTE=600
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_SERVICE_URL=http://auth-service:4001
ATHLETE_SERVICE_URL=http://athlete-service:4002
UNIVERSITY_SERVICE_URL=http://university-service:4003
APPLICATION_SERVICE_URL=http://application-service:4004
PAYMENT_SERVICE_URL=http://payment-service:4005
ESIGN_SERVICE_URL=http://esign-service:4006
DOCUMENT_SERVICE_URL=http://document-service:4007
NOTIFICATION_SERVICE_URL=http://notification-service:4008
FINANCE_SERVICE_URL=http://finance-service:4009
